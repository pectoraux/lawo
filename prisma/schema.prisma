// =============================================================================
// Nomos — Platform Foundation Schema (Plane E)
// =============================================================================
// PostgreSQL (Neon) — native enums supported. Auth models aligned with
// NextAuth.js v4 + Prisma Adapter conventions.
//
// Domain-agnostic kernel persistence: vertical concepts (InsuranceClaim, ADU,
// AfCFTAShipment, etc.) live in package data, never as Prisma models.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  GUEST
  USER
  OPERATOR
  PACKAGER
  ADMIN
}

enum UserStatus {
  WAITLISTED
  ACTIVE
  DISABLED
}

enum TenantKind {
  INDIVIDUAL
  HOUSEHOLD
  SMALL_BUSINESS
  ENTERPRISE
  PROFESSIONAL_ORG
  GOVERNMENT
  EMBEDDED
}

enum AuditSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum TruthLevel {
  T0
  T1
  T2
  T3
  T4
  T5
}

enum PackageCategory {
  JURISDICTION
  DOMAIN
  SITUATION
  CAPABILITY
}

enum JurisdictionKind {
  COUNTRY
  REGION
  STATE
  MUNICIPALITY
  REGULATOR
  COURT
  SPECIAL_ZONE
  FREE_ZONE
  SUPRANATIONAL
  BILATERAL
  INTERNATIONAL
}

// -----------------------------------------------------------------------------
// Identity — NextAuth User. Email is the login handle.
//
// `role`     : GUEST | USER | OPERATOR | PACKAGER | ADMIN — drives capability.
// `status`   : WAITLISTED (signup pending admin approval) | ACTIVE | DISABLED.
// `isDemo`   : true for seed demo accounts (quick-login buttons shown in UI).
// `tenantId` : the user's personal tenant (created at activation).
// -----------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash String?
  name          String?
  image         String?
  role          UserRole  @default(GUEST)
  status        UserStatus @default(WAITLISTED)
  isDemo        Boolean    @default(false)
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Invitation-token flow — replaces the admin-generated temp password.
  // When set, status is WAITLISTED and passwordHash is null; the user
  // completes the set-password flow at /?set_password=<TOKEN> to activate.
  invitationToken      String?  @unique
  invitationExpiresAt  DateTime?

  accounts Account[]
  sessions Session[]

  // Waitlist entries this user has reviewed (admin only)
  reviewedWaitlist WaitlistEntry[] @relation("WaitlistReviewer")

  @@index([status])
  @@index([role])
  @@index([invitationToken])
}

// NextAuth OAuth/credentials account linkage (kept for completeness; we use Credentials only).

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// WaitlistEntry — a sign-up request awaiting admin approval.
//
// When an admin approves an entry, a User (status=ACTIVE) is created and the
// entry is marked APPROVED with `approvedAt` and `approvedById`.
// -----------------------------------------------------------------------------

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

model WaitlistEntry {
  id          String         @id @default(cuid())
  email       String         @unique
  name        String?
  objective   String?
  status      WaitlistStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?
  reviewedById String?
  reviewedBy  User?          @relation("WaitlistReviewer", fields: [reviewedById], references: [id])
  notes       String?

  @@index([status])
  @@index([requestedAt])
}

// -----------------------------------------------------------------------------
// Tenant — a single actor scope. A user has one personal tenant by default.
// -----------------------------------------------------------------------------

model Tenant {
  id        String     @id @default(cuid())
  name      String
  kind      TenantKind @default(INDIVIDUAL)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users         User[]
  auditEvents   AuditEvent[]
  decisions     DecisionRecord[]
  facts         FactRecord[]
  evidence      EvidenceRecord[]
}

// -----------------------------------------------------------------------------
// AuditEvent — append-only audit log entry.
// -----------------------------------------------------------------------------

model AuditEvent {
  id          String       @id @default(cuid())
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  actor       String
  action      String
  subjectId   String?
  timestamp   DateTime     @default(now())
  severity    AuditSeverity @default(INFO)
  payloadJson Json
  // Explicit correlation identifier linking this audit event to the
  // DecisionRecord it documents. Set on durable audit events created in
  // the same $transaction as the DecisionRecord. Nullable for events not
  // tied to a specific decision (waitlist, auth, etc.).
  correlationId String?

  @@index([tenantId, timestamp])
  @@index([severity])
  @@index([correlationId])
}

// -----------------------------------------------------------------------------
// DecisionRecord — a persisted StateSnapshot decision with full provenance.
// -----------------------------------------------------------------------------

model DecisionRecord {
  id              String      @id @default(cuid())
  tenantId        String?
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])
  decisionId      String
  subjectId       String
  situationId     String?
  stateJson       Json
  provenanceJson  Json
  asOf            DateTime
  computedAt      DateTime
  truthLevel      TruthLevel  @default(T0)
  // Explicit correlation identifier. Matches AuditEvent.correlationId so
  // a decision and its durable audit event are bidirectionally linked.
  // UNIQUE: there is exactly one canonical DecisionRecord per decisionId.
  // (AuditEvent.correlationId is NOT unique — multiple audit events can
  // reference the same decision: persist, reviewed, appealed, executed, etc.)
  correlationId   String?  @unique

  @@index([tenantId, computedAt])
  @@index([subjectId])
}

// -----------------------------------------------------------------------------
// PackageRecord — a versioned package manifest in the registry.
// -----------------------------------------------------------------------------

model PackageRecord {
  packageId    String          @unique
  name         String
  version      String
  category     PackageCategory
  manifestJson Json
  publishedAt  DateTime
  signedBy     String
  hash         String

  @@unique([packageId, version])
}

// -----------------------------------------------------------------------------
// RuleVersion — an immutable, versioned Rule.
// -----------------------------------------------------------------------------

model RuleVersion {
  id             String   @id @default(cuid())
  ruleId         String
  version        Int
  ruleJson       Json
  jurisdictionId String
  authorityId    String
  sourceId       String
  packageId      String
  validFrom      DateTime
  validTo        DateTime?
  supersedes     String?
  supersededBy   String?
  publishedAt    DateTime
  ingestedAt     DateTime

  @@unique([ruleId, version])
  @@index([jurisdictionId, validFrom])
  @@index([packageId])
}

// -----------------------------------------------------------------------------
// JurisdictionRecord — a node in the jurisdiction graph.
// -----------------------------------------------------------------------------

model JurisdictionRecord {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  kind         JurisdictionKind
  parentIds    String[]
  packageId    String
  validFrom    DateTime
  validTo      DateTime?
  version      Int
  supersedes   String?
  supersededBy String?
}

// -----------------------------------------------------------------------------
// FactRecord — a stored observation (entity attribute).
// -----------------------------------------------------------------------------

model FactRecord {
  id            String      @id @default(cuid())
  subjectId     String
  attribute     String
  value         Json
  truthLevel    TruthLevel  @default(T0)
  sourceJson    Json?
  observedAt    DateTime    @default(now())
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])
  jurisdictionId String?

  @@index([subjectId, attribute])
  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// EvidenceRecord — a piece of evidence (e.g. a document/page/region) with
// extracted fact ids.
// -----------------------------------------------------------------------------

model EvidenceRecord {
  id              String   @id @default(cuid())
  documentId      String?
  page            Int?
  region          String?
  extractedFactIds String[]
  confidence      Float    @default(1.0)
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
}
